# ==============================================================================
# FIRESHIELD AI — MASTER ENVIRONMENT & CREDENTIALS TEMPLATE (.env.example)
# Copy this file to '.env' and populate with your real keys. NEVER commit '.env'.
# ==============================================================================

# 1. Firebase Project Identifiers
# Search location: Firebase Console -> Project Settings -> General
FIREBASE_PROJECT_ID=smart-fire-detection-272bb
FIREBASE_PROJECT_NUMBER=1061002575810
FIREBASE_AUTH_DOMAIN=smart-fire-detection-272bb.firebaseapp.com
FIREBASE_STORAGE_BUCKET=smart-fire-detection-272bb.firebasestorage.app

# 2. Firebase Realtime Database
# Search location: Firebase Console -> Build -> Realtime Database
FIREBASE_DATABASE_URL=https://smart-fire-detection-272bb-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_REGION=asia-southeast1

# 3. Firebase Web API Key
# Search location: Firebase Console -> Project Settings -> General -> Web API Key
FIREBASE_WEB_API_KEY=AIzaSyCxnGiInekI9FX6f7yUPuwxucYpHrUZWws

# 4. Hardware Node Authentication (ESP8266 Auth)
# Search location: Firebase Console -> Build -> Authentication -> Users
DEVICE_AUTH_EMAIL=esp1@smartfiredetection.local
DEVICE_AUTH_PASSWORD=YOUR_DEVICE_AUTH_PASSWORD_HERE

# 5. Firebase Admin Service Account Key
# Search location: Firebase Console -> Project Settings -> Service Accounts -> "Generate new private key"
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# 6. Push Notifications (FCM)
# Search location: Firebase Console -> Project Settings -> Cloud Messaging
FCM_SENDER_ID=1061002575810
FCM_SERVER_KEY=your_fcm_server_key_here

# 7. Local Ingestion Server (Optional)
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SECRET_KEY=fireshield_secret_key_prod_2026
DEVICE_INGESTION_API_KEY=fireshield_local_dev_key_2026

# 8. Detection Thresholds
FLAME_THRESHOLD_ADC=8000
GAS_THRESHOLD_ADC=12000
PERSISTENCE_TIME_SEC=3
ROOM_DEFAULT_ID=living_room
