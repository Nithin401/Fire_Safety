# ==============================================================================
# FIRESHIELD AI — BACKEND & ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and populate with your credentials. NEVER commit '.env'.
# ==============================================================================

# Server Network Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SECRET_KEY=dev-insecure-secret-key-change-in-production

# Firebase Firestore Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# API Ingestion Security
DEVICE_INGESTION_API_KEY=fireshield_local_dev_key_2026

# Alert Providers
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
FCM_SERVER_KEY=your_fcm_server_key_here

# Telemetry Thresholds (Prototype Backstop)
FLAME_THRESHOLD_ADC=400
PERSISTENCE_TIME_SEC=3
