# FireShield AI Flask Backend Configuration Template (.env.example)
# Copy this file to .env and supply your channel ID and read key.
# NEVER commit the real .env file.

# ThingSpeak Channel Settings
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_BASE_URL=https://api.thingspeak.com

# Flask Application Settings
FLASK_SECRET_KEY=change_this_to_a_random_secure_key
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Polling & Cache Settings
POLL_INTERVAL_SECONDS=15
MAX_HISTORY_RESULTS=500
CACHE_TTL_SECONDS=15
STALE_THRESHOLD_SECONDS=60

# Allowed CORS Origins (comma-separated, for Flutter Web / App clients)
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Web Push Notifications (VAPID)
# Keys are automatically generated and saved to data/vapid_keys.json if not specified here
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@fireshield.local

# Mobile Push Notifications via ntfy (No Firebase required)
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=fireshield_alerts_your_unique_topic
NTFY_ACCESS_TOKEN=

# Risk Evaluation Engine Parameters
EARLY_WARNING_TEMP_RISE_RATE_C_PER_MIN=1.5
BASELINE_ANOMALY_SIGMA_THRESHOLD=2.5
COOLDOWN_SECONDS_EARLY_WARNING=300
COOLDOWN_SECONDS_ANOMALY=600
ALL_CLEAR_CONSECUTIVE_READINGS=3

# Exotel Outbound Voice Calls (India Telephony)
# Trial accounts include ₹1,000 credits for testing to verified numbers.
# Keep VOICE_ALERT_DRY_RUN=true until ready to place live calls.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_API_BASE_URL=https://api.exotel.com
EXOTEL_APP_ID=
FIRESHIELD_ALERT_PHONE=
VOICE_ALERT_ENABLED=false
VOICE_ALERT_DRY_RUN=true
VOICE_ALERT_COOLDOWN_SECONDS=300
PUBLIC_BASE_URL=http://localhost:5000
